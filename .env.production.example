POSTGRES_DB=amielar_production
POSTGRES_USER=amielar_app
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_VALUE

# URL-encode reserved characters in the password before placing it in this URL.
DATABASE_URL=postgresql://amielar_app:CHANGE_ME_GENERATE_SECURE_VALUE@db:5432/amielar_production

ADMIN_USERNAME=CHANGE_ME_PRODUCTION_ADMIN
ADMIN_PASSWORD_HASH=CHANGE_ME_GENERATE_SCRYPT_HASH
ADMIN_SESSION_SECRET=CHANGE_ME_GENERATE_32_BYTE_SECRET
APP_ORIGIN=https://amielarargentina.com
NODE_ENV=production

# Immutable Git SHA tags are the deployment references; replace both values together.
APP_IMAGE=ghcr.io/catarb/amielar-app:REPLACE_WITH_IMMUTABLE_SHA
MIGRATOR_IMAGE=ghcr.io/catarb/amielar-migrator:REPLACE_WITH_IMMUTABLE_SHA

# Docker volume names; keep them distinct from local QA volumes.
POSTGRES_VOLUME_NAME=amielar-production-postgres-data
CADDY_DATA_VOLUME_NAME=amielar-production-caddy-data
CADDY_CONFIG_VOLUME_NAME=amielar-production-caddy-config
